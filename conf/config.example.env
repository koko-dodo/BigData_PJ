# Copy to conf/local.env and edit. Never put credentials in this file.
SPARK_MASTER=spark://master:7077
SPARK_DRIVER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=2g
SPARK_TOTAL_EXECUTOR_CORES=4
SHUFFLE_PARTITIONS=32
RAW_INPUT_PATH=hdfs://master:9000/aiops/metric
CLEAN_OUTPUT_PATH=hdfs://master:9000/aiops/output/clean_metrics
INPUT_PATH=hdfs://master:9000/aiops/output/clean_metrics
# Dedicated output for this run. Scripts overwrite this directory's job outputs.
OUTPUT_ROOT=hdfs://master:9000/aiops/output/portfolio_run
METRIC_TYPES=service,node,jvm,istio,container
FINAL_RULE=and
Z_THRESHOLD=3.0
WINDOW_ROWS=100
MIN_WINDOW_POINTS=30
TOP_K=30
MIN_ANOMALY_METRICS=2
